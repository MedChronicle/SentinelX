# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Vite / tool caches
.vite/
.cache/
vite.config.*.timestamp-*

# Environment variables (keep a .env.example if you add one)
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
__MACOSX/

# Test / coverage output
coverage/

# Figma Make / platform-managed state (not project source)
# Note: .figma/make/ is NOT ignored because vite.config.ts imports site.json
/.figma/design-context/
/.plugins/
/.opencode-skills/
.claude-replay.*
.tmp-*
